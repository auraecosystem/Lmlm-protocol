# SIL App Builder - Worksheet Style & Layout Configuration
# Format: Property = Value

[Layout]
theme.color.primary = #2C3E50
theme.color.accent = #18BC9C
font.size.base = 16
font.family = "Charis SIL"
padding.content = 12
show.progress.bar = true

[QuizLayout]
question.spacing = 20
choice.layout = grid_2x2
choice.background = #F8F9FA
choice.border.color = #BDC3C7
choice.border.radius = 8
correct.color = #2ECC71
incorrect.color = #E74C3C
